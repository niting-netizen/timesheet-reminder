# Copy to .env and fill in. Never commit .env.
# 32-byte key, base64. Generate with: npm run keygen
TSR_MASTER_KEY=
# Admin login password for the dashboard (at least 12 characters)
TSR_ADMIN_PASSWORD=
# Optional
PORT=8787
HOST=127.0.0.1
TSR_DB_PATH=./data/timesheet.sqlite
# Set to true only for internal sources served over plain http (credentials travel unencrypted)
TSR_ALLOW_INSECURE_SOURCES=false
